# OpenShift AI (RHOAI) Platform Configuration
# ---------------------------------------------
# Copy this file to ai-platform.env and populate with real values.
#   cp ai-platform.template.env ai-platform.env
#
# ai-platform.env is gitignored. Never commit it.

# OpenShift AI dashboard URL (visible in the RHOAI web console)
AI_PLATFORM_DASHBOARD_URL=<your-rhoai-dashboard-url>

# Internal RHOAI API endpoint (used for programmatic access)
AI_PLATFORM_API_URL=<your-rhoai-api-url>

# NGC API key for pulling images from nvcr.io (NVIDIA NGC)
# Generate at: https://org.ngc.nvidia.com/setup/api-keys
NGC_API_KEY=<your-ngc-api-key>

# Model registry / S3-compatible storage endpoint (if used)
MODEL_REGISTRY_ENDPOINT=<your-model-registry-endpoint>
MODEL_REGISTRY_ACCESS_KEY=<your-access-key>
MODEL_REGISTRY_SECRET_KEY=<your-secret-key>
MODEL_REGISTRY_BUCKET=<your-bucket-name>
