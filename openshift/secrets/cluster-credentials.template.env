# OpenShift Cluster Access Credentials
# -------------------------------------
# Copy this file to cluster-credentials.env and populate with real values.
#   cp cluster-credentials.template.env cluster-credentials.env
#
# cluster-credentials.env is gitignored. Never commit it.

# API endpoint for your OpenShift cluster (include port 6443)
OPENSHIFT_API_URL=https://api.your-cluster.example.com:6443

# Short-lived OAuth token obtained via:
#   oc login https://api.your-cluster.example.com:6443
#   oc whoami --show-token
OPENSHIFT_TOKEN=<your-oauth-token-here>

# Project namespace where workloads are deployed
OPENSHIFT_NAMESPACE=<your-project-namespace>

# OpenShift username (used for audit/logging context only, not auth)
OPENSHIFT_USER=<your-username>
